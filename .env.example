# Copy to apps/<site>/.env.local (git-ignored) and fill in real values.
# The values below are non-secret placeholders, also used by CI.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
# Supabase auth user id whose `content` rows this site shows.
VITE_SUPABASE_USER_ID=00000000-0000-0000-0000-000000000000
